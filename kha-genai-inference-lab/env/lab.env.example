# Kestrel Health Alliance (KHA) GenAI Inference Lab - environment
# 1) cp env/lab.env.example env/lab.env   2) fill in   3) from the REPO ROOT: source env/lab.env
# env/lab.env is git-ignored. Works in bash and zsh.

# ---------- Azure ----------
export SUBSCRIPTION_ID=""                 # az account show --query id -o tsv
export LOCATION="eastus"                  # region with A100/H100 quota (scripts/preflight.sh checks)
export RG="rg-kha-genai-lab"
export PREFIX="khalab"                    # 3-10 lowercase letters/digits; used in resource names
export AKS_NAME="${PREFIX}-aks"
export K8S_VERSION=""                     # empty = AKS default. 1.34+ recommended (DRA is GA there)

# ---------- GPU choice ----------
export GPU_PROFILE="a100"                 # a100 | h100  -> loads env/gpu-<profile>.env
export GPU_PRIORITY="Spot"                # Spot (~80% cheaper, evictable) | Regular
export MIG_POOL="gpumig"                  # 1-GPU pool, partitioned with MIG (M1+)
export DYN_POOL="gpudyn"                  # 2-GPU pool for KAI + Dynamo (M8/M10 only)

# ---------- Pinned versions (verified 2026-09-28) ----------
export GPU_OPERATOR_VERSION="v26.7.1"
export NIM_OPERATOR_VERSION="3.1.2"
export KPS_VERSION="91.8.1"               # kube-prometheus-stack
export PROM_ADAPTER_VERSION="5.3.0"
export KAI_VERSION="v0.18.0"
export DYNAMO_VERSION="1.5.0"
export AIPERF_VERSION="0.13.0"
export NGC_RELEASE="26.08"                # Triton / PyTorch / TensorRT must share one release
export CUDA_DEVEL_IMAGE="nvcr.io/nvidia/cuda:13.4.1-devel-ubuntu24.04"
export CUDA_BASE_IMAGE="nvcr.io/nvidia/cuda:13.4.1-base-ubuntu24.04"

# ---------- Models ----------
export NIM_LLM_IMAGE="nvcr.io/nim/meta/llama-3.1-8b-instruct-pb6"
export NIM_LLM_TAG="2.0.4-pb6.7"          # check NGC for the newest 2.0.x-pb6.* tag
export NIM_LLM_MODEL="meta/llama-3.1-8b-instruct"   # confirm with GET /v1/models
export NIM_EMBED_IMAGE="nvcr.io/nim/nvidia/llama-nemotron-embed-1b-v2"
export NIM_EMBED_TAG="1.13.0"
export NIM_EMBED_MODEL="nvidia/llama-nemotron-embed-1b-v2"
export TOKENIZER="meta-llama/Llama-3.1-8B-Instruct" # gated on HF: accept the license, set HF_TOKEN
export DYNAMO_MODEL="Qwen/Qwen3-8B"                 # ungated
export TRIAGE_BASE_MODEL="distilbert-base-uncased"
export PRIORAUTH_CACHE_FLAG="--enable-prefix-caching"   # M7 flips to --no-enable-prefix-caching

# ---------- Secrets (pushed to Key Vault by workloads/create-secrets.sh) ----------
export NGC_API_KEY=""                     # NVIDIA Developer Program membership is enough for dev/test
export HF_TOKEN=""

# ---------- Derived (do not edit) ----------
if [ -f "env/gpu-${GPU_PROFILE}.env" ]; then . "env/gpu-${GPU_PROFILE}.env"; else echo "Run from the repo root: env/gpu-${GPU_PROFILE}.env not found"; fi
if [ -f env/outputs.env ]; then . env/outputs.env; fi
if [ "${GPU_PRIORITY}" = "Spot" ]; then
  export GPU_HOURLY_USD="${GPU_HOURLY_SPOT}" DYN_HOURLY_USD="${DYN_HOURLY_SPOT}"
else
  export GPU_HOURLY_USD="${GPU_HOURLY_PAYG}" DYN_HOURLY_USD="${DYN_HOURLY_PAYG}"
fi
