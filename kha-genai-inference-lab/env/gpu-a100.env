# NVIDIA A100 80GB PCIe - Azure NC A100 v4. Prices: Azure Retail Prices API, eastus, 2026-09-28.
export GPU_VM_SKU="Standard_NC24ads_A100_v4"   # 1x A100 80GB, 24 vCPU
export DYN_VM_SKU="Standard_NC48ads_A100_v4"   # 2x A100 80GB, 48 vCPU
export GPU_QUOTA_GREP="A100"
export MIG_LARGE="nvidia.com/mig-3g.40gb"      # prior-auth NIM
export MIG_MEDIUM="nvidia.com/mig-2g.20gb"     # shared NIM (member chat by day, claims batch by night)
export MIG_SMALL="nvidia.com/mig-1g.10gb"      # embedding NIM + triage (Triton)
export CUDA_ARCH="80"
export LLM_PRECISION="bf16"                    # Ampere has no FP8 tensor cores
export PRIORAUTH_MAX_MODEL_LEN="8192"
export PRIORAUTH_EXTRA_ARGS="--max-num-seqs 32"
export SHARED_MAX_MODEL_LEN="4096"
# 8B BF16 weights (~15 GiB) nearly fill a 20 GB slice: shrink activation buffers to leave KV-cache room.
export SHARED_EXTRA_ARGS="--gpu-memory-utilization 0.95 --max-num-batched-tokens 2048 --max-num-seqs 32"
export PEAK_MEM_BW_GBPS="1935"
export GPU_HOURLY_PAYG="3.673"
export GPU_HOURLY_SPOT="0.6788"
export DYN_HOURLY_PAYG="7.346"
export DYN_HOURLY_SPOT="1.3575"
