# NVIDIA H100 NVL 94GB - Azure NC H100 v5. Prices: Azure Retail Prices API, eastus, 2026-09-28.
# After M2, confirm MIG resource names: kubectl get node -l kha.io/pool=mig -o json | jq '.items[0].status.allocatable'
export GPU_VM_SKU="Standard_NC40ads_H100_v5"   # 1x H100 NVL, 40 vCPU
export DYN_VM_SKU="Standard_NC80adis_H100_v5"  # 2x H100 NVL, 80 vCPU
export GPU_QUOTA_GREP="H100"
export MIG_LARGE="nvidia.com/mig-3g.47gb"
export MIG_MEDIUM="nvidia.com/mig-2g.24gb"
export MIG_SMALL="nvidia.com/mig-1g.12gb"
export CUDA_ARCH="90"
export LLM_PRECISION="fp8"                     # Hopper FP8; compare against bf16 in M7
export PRIORAUTH_MAX_MODEL_LEN="16384"
export PRIORAUTH_EXTRA_ARGS="--max-num-seqs 64"
export SHARED_MAX_MODEL_LEN="8192"
export SHARED_EXTRA_ARGS="--max-num-seqs 64"
export PEAK_MEM_BW_GBPS="3900"
export GPU_HOURLY_PAYG="6.98"
export GPU_HOURLY_SPOT="1.2899"
export DYN_HOURLY_PAYG="13.96"
export DYN_HOURLY_SPOT="2.5798"
