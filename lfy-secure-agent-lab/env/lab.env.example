# Lanternfly Security (LFY) - Secure Agentic AI Lab (Lab 03) - environment
# Same pattern as Lab 02:  cp env/lab.env.example env/lab.env ; fill in ; from the REPO ROOT: source env/lab.env

# ---------- Azure ----------
export SUBSCRIPTION_ID=""
export LOCATION="eastus"
export RG="rg-lfy-secure-agent-lab"
export PREFIX="lfylab"
export AKS_NAME="${PREFIX}-aks"
export K8S_VERSION=""
export CVM_LOCATION="eastus2"             # M12 confidential H100 VM region (needs NCCadsH100v5 quota)

# ---------- GPU choice (identical to Lab 02) ----------
export GPU_PROFILE="a100"                 # a100 | h100
export GPU_PRIORITY="Spot"                # Spot | Regular
export MIG_POOL="gpumig"
export DYN_POOL="gpudyn"                  # unused in Lab 03; kept so Lab 02 scripts run unchanged

# ---------- Pinned versions (verified 2026-10-04) ----------
export GPU_OPERATOR_VERSION="v26.7.1"
export NIM_OPERATOR_VERSION="3.1.2"
export KPS_VERSION="91.8.1"
export PROM_ADAPTER_VERSION="5.3.0"
export AIPERF_VERSION="0.13.0"
export GARAK_VERSION="0.17.0"
export NEMOGUARDRAILS_VERSION="0.24.1"
export NAT_VERSION="1.9.0"                # NeMo Agent Toolkit
export NGC_RELEASE="26.08"
export CUDA_DEVEL_IMAGE="nvcr.io/nvidia/cuda:13.4.1-devel-ubuntu24.04"
export CUDA_BASE_IMAGE="nvcr.io/nvidia/cuda:13.4.1-base-ubuntu24.04"

# ---------- Models ----------
export NIM_LLM_IMAGE="nvcr.io/nim/meta/llama-3.1-8b-instruct-pb6"   # same model as Lab 02 = the agent's reasoning LLM
export NIM_LLM_TAG="2.0.4-pb6.7"
export NIM_LLM_MODEL="meta/llama-3.1-8b-instruct"
export NIM_SAFETY_IMAGE="nvcr.io/nim/nvidia/llama-3.1-nemotron-safety-guard-8b-v3"   # content safety, 23 categories, multilingual
export NIM_SAFETY_TAG="latest"            # pin the digest after the first pull (M4 step)
export NIM_SAFETY_MODEL="nvidia/llama-3.1-nemotron-safety-guard-8b-v3"   # confirm with GET /v1/models
export NIM_JAILBREAK_IMAGE="nvcr.io/nim/nvidia/nemoguard-jailbreak-detect"
export NIM_JAILBREAK_TAG="1.10.1"
export NIM_EMBED_IMAGE="nvcr.io/nim/nvidia/llama-nemotron-embed-1b-v2"  # same as Lab 02
export NIM_EMBED_TAG="1.13.0"
export NIM_EMBED_MODEL="nvidia/llama-nemotron-embed-1b-v2"
export TOKENIZER="meta-llama/Llama-3.1-8B-Instruct"
export KUSTAINER_IMAGE="mcr.microsoft.com/azuredataexplorer/kustainer-linux:latest"   # Azure Data Explorer emulator: real KQL, no cloud cost
export AGENT_CACHE_FLAG="--enable-prefix-caching"   # Lab 02 prediction B again: agent loops resend the same system prompt

# ---------- Images you build (M6/M7) ----------
export APP_TAG="1.0.0"
export FAIL_MODE="closed"                 # guarded gateway when a safety model errors: closed (refuse) | open (drill 6)

# ---------- Secrets ----------
export NGC_API_KEY=""
export HF_TOKEN=""

# ---------- Derived (do not edit) ----------
if [ -f "env/gpu-${GPU_PROFILE}.env" ]; then . "env/gpu-${GPU_PROFILE}.env"; else echo "Run from the repo root: env/gpu-${GPU_PROFILE}.env not found"; fi
if [ -f env/outputs.env ]; then . env/outputs.env; fi
if [ -n "${ACR_NAME:-}" ]; then export ACR_LOGIN_SERVER="${ACR_NAME}.azurecr.io"; else export ACR_LOGIN_SERVER="${ACR_LOGIN_SERVER:-}"; fi
if [ "${GPU_PRIORITY}" = "Spot" ]; then
  export GPU_HOURLY_USD="${GPU_HOURLY_SPOT}" DYN_HOURLY_USD="${DYN_HOURLY_SPOT}"
else
  export GPU_HOURLY_USD="${GPU_HOURLY_PAYG}" DYN_HOURLY_USD="${DYN_HOURLY_PAYG}"
fi
