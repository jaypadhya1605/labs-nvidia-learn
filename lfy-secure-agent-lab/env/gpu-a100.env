# NVIDIA A100 80GB PCIe - Azure NC A100 v4 (same as Lab 02). Prices: Azure Retail Prices API, eastus, 2026-09-28.
export GPU_VM_SKU="Standard_NC24ads_A100_v4"
export DYN_VM_SKU="Standard_NC48ads_A100_v4"
