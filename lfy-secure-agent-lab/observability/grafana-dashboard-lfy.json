      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(guardrail_errors_total[5m]))",
          "legendFormat": "errors/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
