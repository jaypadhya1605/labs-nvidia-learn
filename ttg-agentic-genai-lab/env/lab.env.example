# Copy to env/lab.env (git-ignored), fill in, then:  . env/pins.env && . env/lab.env
# Never commit keys. Hosted endpoints (build.nvidia.com) get SYNTHETIC data only - Tern Travel Group is fictional.

# --- Keys ---------------------------------------------------------------------------------------------------------------
export HF_TOKEN=""                    # Hugging Face token with the Llama 3.1 license accepted (gated model)
export NGC_API_KEY=""                 # nvcr.io pulls (NIM, TRT-LLM, NGC PyTorch) + NIM model download
export NVIDIA_API_KEY=""              # build.nvidia.com hosted endpoints (M3, M8, optional M6 teacher)

# --- The GPU you rent (recorded with every bench run; drives $ per 1,000 disruptions) ----------------------------------
export GPU_NAME="H100-80GB-SXM"       # H100-80GB-SXM | L40S-48GB | A100-80GB-PCIe | RTX-PRO-6000 ...
export GPU_HOURLY_USD="2.49"          # what YOUR provider charges per GPU-hour - check before every session
export GPUS_PER_REPLICA="1"           # GPU COUNT behind one engine replica ($ per 1,000 disruptions; agent_bench --gpus)
# export GPUS="0"                     # DEVICE LIST for engines/launch.sh (docker --gpus device=...). Leave it unset:
                                      # launch.sh uses 0, or 0,1 for tp2/pp2/dp2. Never a count - "1" means GPU #1.

# --- Agent (contract defaults; the engines in engines/launch.sh all serve the model as "ttg-llm") -------------------
export TTG_BASE_URL="http://localhost:8000/v1"
export TTG_API_KEY="not-used"         # hosted: export TTG_API_KEY="${NVIDIA_API_KEY}"
export TTG_MODEL="ttg-llm"            # hosted / NIM id: meta/llama-3.1-8b-instruct; vLLM LoRA: ttg-short; SGLang LoRA: ttg-llm:ttg-short
export TTG_PROMPT_VARIANT="full"      # full | short (M6 prompt-baked LoRA)
export TTG_THOUGHTS="brief"           # brief | verbose (drill)
export TTG_BUST_CACHE="0"             # 1 = drill: timestamp at the top of the system prompt
export TTG_STRUCTURED="none"          # none | json_object | json_schema
export TTG_MAX_STEPS="14"
export TTG_MAX_TOKENS="256"
export TTG_TEMPERATURE="0"
export TTG_TIMEOUT_S="60"
export TTG_TOOL_TIMEOUT_S="10"
export TTG_MCP_MODE="stdio"           # stdio (agent spawns the MCP servers) | http (servers already running)
export TTG_MCP_OPS_URL="http://localhost:8101/mcp"
export TTG_MCP_GUEST_URL="http://localhost:8102/mcp"
export TTG_TRACE_DIR="results/traces"
export TTG_VLM_BASE_URL=""            # M8: e.g. http://localhost:8000/v1 (vLLM + Qwen2.5-VL) or https://integrate.api.nvidia.com/v1
export TTG_VLM_MODEL=""               # M8: Qwen/Qwen2.5-VL-7B-Instruct or meta/llama-3.2-11b-vision-instruct

# --- GitLab + Kubernetes (M9) --------------------------------------------------------------------------------------
export CI_REGISTRY="registry.gitlab.com"
export GITLAB_PROJECT_PATH="your-group/ttg-agentic-genai-lab"
export TTG_IMAGE="registry.gitlab.com/your-group/ttg-agentic-genai-lab/ttg-agent"
export KUBE_CONTEXT="your-group/ttg-agentic-genai-lab:aks"   # GitLab agent for Kubernetes context (deploy jobs)
