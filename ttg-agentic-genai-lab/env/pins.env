# Version pins for Lab 05 - ONE source of truth (verified 2026-10-17: PyPI wheels, vendor docs, and a registry
# HEAD on every container tag below via scripts/check-images.sh).
#   - shell scripts:      . env/pins.env
#   - the Helm chart:     deploy/helm/ttg/values.yaml must match (tests/test_pins.py fails CI on drift)
#   - CI images:          .gitlab-ci.yml variables must match (tests/test_pins.py)
#   - container tags:     scripts/check-images.sh proves each one exists before you rent a GPU
# 🔁 Lab 04 pins are reused unchanged where the same component appears (NIM, TRT-LLM, NGC release, operators).

# --- Inference engines (container images) ------------------------------------------------------------------------
export PIN_VLLM_IMAGE="vllm/vllm-openai"
export PIN_VLLM_TAG="v0.31.0"                         # PyPI vllm 0.31.0; Docker Hub tags are v<version>
export PIN_SGLANG_IMAGE="lmsysorg/sglang"
export PIN_SGLANG_TAG="v0.5.22"                       # default CUDA build (registry HEAD 2026-10-17); v0.5.22-cu130 = CUDA 13
                                                      # build for R580+ drivers; *-runtime = slimmer image without dev tools
export PIN_TRTLLM_IMAGE="nvcr.io/nvidia/tensorrt-llm/release"
export PIN_TRTLLM_TAG="1.3.0rc29"                     # 🔁 Lab 04 (pre-release line; docs checked at 1.4.0rc0)
export PIN_NIM_LLM_IMAGE="nvcr.io/nim/meta/llama-3.1-8b-instruct"
export PIN_NIM_LLM_TAG="2.0.13"                       # 🔁 Lab 04
export PIN_NIM_LIGHTNING_IMAGE="nvcr.io/nim/nvidia/nemotron-3.5-lightning-30b-a3b"   # M2 MoE experiment (🔁 Lab 04 add-on)
export PIN_NIM_LIGHTNING_TAG="2.0.9-variant"

# --- NGC + build images ----------------------------------------------------------------------------------------------
export PIN_NGC_RELEASE="26.09"                        # nvcr.io/nvidia/pytorch:26.09-py3 (nsys, nccl-tests, training)
export PIN_PYTORCH_IMAGE="nvcr.io/nvidia/pytorch"
export PIN_CUDA_DEVEL="nvcr.io/nvidia/cuda:13.4.1-devel-ubuntu24.04"   # 🔁 Lab 04 CUDA probe base
export PIN_PYTHON_IMAGE="python:3.12-slim"            # deploy/Dockerfile base + CI python jobs
export PIN_KANIKO_IMAGE="gcr.io/kaniko-project/executor:v1.23.2-debug"   # GitLab build job (upstream archived in 2025:
                                                      # swap for buildah or the Chainguard fork if your runner policy says so)
export PIN_SHELLCHECK_IMAGE="koalaman/shellcheck-alpine:v0.11.0"
export PIN_HELM="v3.22.1"                             # 🔁 Lab 04 (newest Helm 3; do not drift into Helm 4 mid-lab)
export PIN_HELM_IMAGE="alpine/helm:3.22.1"            # GitLab deploy + helm-lint jobs (same Helm as PIN_HELM)
export PIN_KIND="v0.30.0"                            # kind CLI (its default node image is the one below)
export PIN_KIND_NODE_IMAGE="kindest/node:v1.34.0"     # M9 laptop cluster: kind create cluster --image ...
export PIN_KUBECONFORM="v0.8.0"
export PIN_RUFF="0.16.8"                             # CI lint jobs + requirements-dev.txt
export PIN_UV="0.12.24"                              # GPU VM + perf-gate runner: Python 3.12 venv (gpu-vm-bootstrap.sh)

# --- Kubernetes platform (🔁 Lab 04 clusters, M9) ------------------------------------------------------------------
export PIN_GPU_OPERATOR="v26.7.2"
export PIN_NIM_OPERATOR="3.1.2"

# --- Python packages ---------------------------------------------------------------------------------------------------
export PIN_VLLM="0.31.0"
export PIN_SGLANG="0.5.22"
export PIN_TENSORRT_LLM="1.2.1"                       # PyPI stable; the container above is the pre-release line
export PIN_AIPERF="0.13.0"                            # 🔁 Lab 02-04
export PIN_TRL="1.16.0"
export PIN_PEFT="0.21.2"
export PIN_TRANSFORMERS="5.20.1"
export PIN_ACCELERATE="1.15.0"
export PIN_DATASETS="5.1.0"
export PIN_TORCH="2.14.1"
export PIN_LANGGRAPH="1.2.16"
export PIN_LANGCHAIN_CORE="1.6.12"
export PIN_LANGCHAIN_MCP_ADAPTERS="0.3.2"
export PIN_MCP="1.30.0"                               # what langchain-mcp-adapters 0.3.2 resolves to (PyPI has 2.x)
export PIN_OPENAI="3.35.1"
export PIN_FASTAPI="0.143.2"
export PIN_UVICORN="0.53.0"
export PIN_HTTPX="0.28.1"
export PIN_PYDANTIC="2.13.5"
export PIN_NAT="1.9.0"                                # NVIDIA NeMo Agent Toolkit (nvidia-nat)

# --- Models + names ----------------------------------------------------------------------------------------------------
export PIN_AGENT_MODEL="meta-llama/Llama-3.1-8B-Instruct"        # gated: accept the Llama 3.1 license on Hugging Face
export PIN_AGENT_MODEL_FP8="nvidia/Llama-3.1-8B-Instruct-FP8"    # ModelOpt checkpoint (TRT-LLM FP8; Ada/Hopper/Blackwell)
export PIN_NIM_MODEL="meta/llama-3.1-8b-instruct"                # NIM + build.nvidia.com id
export PIN_VLM_MODEL="Qwen/Qwen2.5-VL-7B-Instruct"               # M8, self-hosted on vLLM
export PIN_HOSTED_VLM_MODEL="meta/llama-3.2-11b-vision-instruct" # M8, build.nvidia.com (synthetic images only)
export PIN_SERVED_MODEL_NAME="ttg-llm"                           # every engine serves the base model under this name
export PIN_LORA_NAME="ttg-short"                                 # M6 prompt-baked adapter
