# Plover Health AI - multi-cloud NVIDIA AI lab (Lab 04)
#   cp env/lab.env.example env/lab.env  ;  fill in  ;  from the REPO ROOT:  source env/lab.env
# env/lab.env is git-ignored. bash 3.2 (macOS) and zsh compatible.

# ---------- Which clusters you run (required: aks gke; stretch: eks oke; M9: rke2) ----------
export PLV_CLUSTERS="${PLV_CLUSTERS:-aks gke}"

# ---------- Your Git + GHCR (GitOps source, app image, LoRA adapters) ----------
export GITHUB_OWNER="your-github-user"
export GIT_REPO_URL="https://github.com/${GITHUB_OWNER}/plv-multicloud-nim-lab.git"
export GITHUB_OWNER_LC="$(echo "${GITHUB_OWNER}" | tr '[:upper:]' '[:lower:]')"   # registries need lowercase (ghcr.io/<owner>)
export GIT_REVISION="main"

# ---------- Azure (AKS, required) ----------
export AZ_SUBSCRIPTION_ID=""
export AZ_LOCATION="eastus"
export AZ_RG="rg-plv-lab"
export AZ_GPU_SKU="Standard_NC24ads_A100_v4"     # 1x A100 80GB PCIe
export AZ_GPU_PRIORITY="Spot"                    # Spot | Regular
export AZ_GPU_MAX_NODES="${AZ_GPU_MAX_NODES:-1}"   # M7: AZ_GPU_MAX_NODES=2 infra/tf.sh aks up (needs 48 vCPU quota)

# ---------- Google Cloud (GKE, required) ----------
export GCP_PROJECT=""
export GCP_REGION="us-central1"
export GCP_ZONE="us-central1-a"                  # pick a zone that has your GPU (gcloud compute accelerator-types list)
export GKE_GPU_PROFILE="rtxpro6000"              # rtxpro6000 (G4, NIM-verified, Blackwell) | a100-40 (A2) | l4 (G2, not NIM-verified)
export GKE_GPU_SPOT="true"
export GKE_GPU_MAX_NODES="${GKE_GPU_MAX_NODES:-1}"   # M7: GKE_GPU_MAX_NODES=2 infra/tf.sh gke up

# ---------- AWS (EKS, stretch) ----------
export AWS_REGION="us-east-1"
export EKS_GPU_INSTANCE="g6e.xlarge"             # 1x L40S 48GB (NIM-verified for Llama 3.1 8B)

# ---------- Oracle Cloud (OKE, stretch) ----------
export OCI_REGION="us-ashburn-1"
export OCI_COMPARTMENT_OCID=""
export OCI_TENANCY_OCID=""
export OKE_GPU_SHAPE="VM.GPU.A10.1"              # 1x A10 24GB (selector exercise: not on the NIM verified list)

# ---------- Data-center simulation VM (M9) ----------
export DC_VM_SKU="Standard_NC24ads_A100_v4"      # pause AKS first (infra/tf.sh aks pause) to free GPU quota
export DC_VM_PRIORITY="Spot"
export DC_USER="plvadmin"                        # admin user Terraform creates on the DC VM (infra/terraform/dc-sim)

# ---------- GPU node $/hour for bench cost columns (defaults = selector/instances.yaml, Spot, 2026-10-15) ----------
export GPU_HOURLY_AKS="0.67877"                  # Standard_NC24ads_A100_v4 Spot, eastus
export GPU_HOURLY_GKE="1.62936"                  # g4-standard-48 Spot, us-central1
export GPU_HOURLY_EKS="1.861"                    # g6e.xlarge on-demand, us-east-1
export GPU_HOURLY_OKE="2.00"                     # VM.GPU.A10.1
export GPU_HOURLY_RKE2="0.67877"                 # DC-sim VM; for a real DC use amortized $/GPU-hour

# ---------- kubectl contexts (created by infra/tf.sh) ----------
export KCTX_AKS="plv-aks"
export KCTX_GKE="plv-gke"
export KCTX_EKS="plv-eks"
export KCTX_OKE="plv-oke"
export KCTX_RKE2="plv-rke2"

# ---------- Secrets (uploaded to each cloud's secret manager by scripts/put-secrets.sh) ----------
export NGC_API_KEY=""
export HF_TOKEN=""                               # Llama 3.1 license accepted on huggingface.co (tokenizer + LoRA training)

# ---------- Derived (do not edit) ----------
if [ -f env/pins.env ]; then . env/pins.env; else echo "Run from the repo root: env/pins.env not found"; fi
for _c in aks gke eks oke dc; do
  if [ -f "env/outputs-${_c}.env" ]; then . "env/outputs-${_c}.env"; fi
done
unset _c
