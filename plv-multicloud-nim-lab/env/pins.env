# Version pins for Lab 04 - verified 2026-10-15. ONE source of truth:
#   - shell scripts `source env/pins.env`
#   - fleet/whats_new.py compares these against upstream
#   - tests/chart/test_pins.py fails CI if a GitOps manifest drifts from these values
export PIN_GPU_OPERATOR="v26.7.2"          # Lab 02/03 used v26.7.1 -> patch bump, see M11 "what's new"
export PIN_NIM_OPERATOR="3.1.2"
export PIN_KPS="92.9.0"                    # kube-prometheus-stack (Lab 02 used 91.8.1)
export PIN_PROM_ADAPTER="5.3.0"
export PIN_ESO="2.12.0"                    # External Secrets Operator chart
export PIN_ARGOCD_CHART="10.10.5"          # Argo CD v3.5.5
export PIN_AIPERF="0.13.0"
export PIN_MLFLOW="3.17.1"
export PIN_PEFT="0.21.2"
export PIN_TRANSFORMERS="5.20.0"
export PIN_ORAS="v1.3.4"
export PIN_NGC_RELEASE="26.09"             # NGC PyTorch / TensorRT / Triton containers
export PIN_CUDA_DEVEL="nvcr.io/nvidia/cuda:13.4.1-devel-ubuntu24.04"
export PIN_NIM_LLM_IMAGE="nvcr.io/nim/meta/llama-3.1-8b-instruct"
export PIN_NIM_LLM_TAG="2.0.13"            # feature branch: Blackwell RTX PRO 6000 + NVFP4 + LoRA profiles
export PIN_TRTLLM_IMAGE="nvcr.io/nvidia/tensorrt-llm/release"
export PIN_TRTLLM_TAG="1.3.0rc29"          # pre-release line; scripts/check-images.sh verifies it exists
export PIN_GKE_DRIVER_INSTALLER_REF="5b774eea3ddaf3afea8f9968de512db0c80ef5a9"   # GoogleCloudPlatform/container-engine-accelerators, 2026-09-25
export PIN_RKE2="v1.36.5+rke2r1"            # M9 data-center sim (one minor behind latest v1.37.x on purpose)
export PIN_HELM="v3.22.1"                  # newest Helm 3 (Helm 4 is a major: evaluate it in M11 "what's new", do not drift into it)
export PIN_DC_DRIVER_BRANCH="580-server"   # host driver (R580 LTSB) - GPU Operator's own default would be R595
export PIN_REGISTRY_IMAGE="docker.io/library/registry:3.1.2"
export PIN_NIM_LIGHTNING_IMAGE="nvcr.io/nim/nvidia/nemotron-3.5-lightning-30b-a3b"   # add-on (NIM docs: 2.0.9-variant)
export PIN_NIM_LIGHTNING_TAG="2.0.9-variant"
export PIN_TF_AZURERM="~> 5.10"
export PIN_TF_GOOGLE="~> 8.7"
export PIN_TF_AWS="~> 6.69"
export PIN_TF_OCI="~> 9.10"
