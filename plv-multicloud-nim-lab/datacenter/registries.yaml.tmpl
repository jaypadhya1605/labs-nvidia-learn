# /etc/rancher/rke2/registries.yaml - containerd mirror config written by datacenter/stage-images.sh.
# Every upstream registry resolves to the local registry; the rewrite keeps registries apart inside it
# (nvcr.io/nvidia/x -> 127.0.0.1:5000/nvcr.io/nvidia/x). Pods still say "nvcr.io/..." - nothing in Git changes.
mirrors:
  nvcr.io:
    endpoint: ["http://127.0.0.1:5000"]
    rewrite: {"^(.*)$": "nvcr.io/$1"}
  ghcr.io:
    endpoint: ["http://127.0.0.1:5000"]
    rewrite: {"^(.*)$": "ghcr.io/$1"}
  docker.io:
    endpoint: ["http://127.0.0.1:5000"]
    rewrite: {"^(.*)$": "docker.io/$1"}
  registry.k8s.io:
    endpoint: ["http://127.0.0.1:5000"]
    rewrite: {"^(.*)$": "registry.k8s.io/$1"}
  quay.io:
    endpoint: ["http://127.0.0.1:5000"]
    rewrite: {"^(.*)$": "quay.io/$1"}
